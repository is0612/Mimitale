# 复制成 .env 后即可用。docker compose 里的 db / mail 起来就能跑，不需要装任何本机服务。

# 数据库 —— 端口故意用 5433，避开本机 5432 上那个别的项目的 postgres
DATABASE_URL="postgresql://mimitale:mimitale@127.0.0.1:5433/mimitale?schema=public"

# 服务
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# 是否信任 X-Forwarded-For 里的客户端 IP。只有前面真挂了 nginx / 云负载均衡才开，
# 否则后台「登录记录」里的 IP 任何人都能随手伪造。直连端口一律 false。
TRUST_PROXY=false

# JWT 密钥 —— 上线前务必换成一串随机值（openssl rand -hex 32）
JWT_SECRET="dev-only-change-me-in-production"
# 管理员 token 有效期（秒）
ADMIN_TOKEN_TTL=7200
# 客户 token 有效期（秒）
CLIENT_TOKEN_TTL=2592000

# 初始管理员 —— 只在第一次 seed 时用到；库里已经有同名账号就不会覆盖
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NICKNAME=星宝

# 发验证码的 SMTP。默认指向 docker 里的 mailpit（本地收信，不真发出去）
# 网页看信：http://127.0.0.1:8025
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Mimitale <no-reply@mimitale.local>"

# 真发邮件时填这些（阿里云邮件推送 / 腾讯云 SES / 随便哪个 SMTP）
# SMTP_HOST=smtpdm.aliyun.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=no-reply@yourdomain.com
# SMTP_PASS=your-smtp-password

# 把验证码直接回给客户端（本地开发和自动化测试用，省得去 mailpit 抄）。
# ⚠️ 上线必须删掉这行或设成 false：开着等于没有邮箱验证，谁都能用任意邮箱注册。
DEV_ECHO_CODE=true

# 是否造 12 个示范客户 + 16 张卡密 + 若干日志，让后台第一次打开不是空表。
# 生产必须 false —— 否则生产库里凭空多出 12 个假客户，而且它们带着会员。
SEED_DEMO=true
