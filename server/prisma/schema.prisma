// Mimitale 账号中心 —— 全是「账号与运营」相关的表。
//
// ⛔ 这里**故意没有**角色卡 / 世界书 / 对话记录 / 本地设置的表。
//    那些东西留在用户自己电脑上，服务器一份都不存。
//    ⚠️ 2026-10-28 加的 feedbacks / announcements **不算破例**：
//    反馈是「人主动发给运营的一段话」，公告是「运营主动发出去的一段话」，
//    两者都是消息，不是用户的创作内容。别顺着这两张表往下把对话也搬上来。
//
// 三条来自决策记录的设计约束：
//   ① 客户（customers）和管理员（admins）是两套账号，不共用表、不做外键
//   ② 操作日志只增不改不删，admin_name / target_name 冗余存，改名不影响历史
//   ③ 不建任何外键 —— 删掉一个管理员不该影响任何客户，关联只靠逻辑字段

generator client {
  // Prisma 7 的新 provider：源码直接生成到 src/generated/，
  // 不再往 node_modules 里写东西，也不再下载数据库引擎（走 pg driver adapter）
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  // URL 不写在这里 —— Prisma 7 挪到了 prisma.config.ts，方便换环境变量来源
  provider = "postgresql"
}

/// 管理员 = 你自己。部署时由 seed 预置，**没有注册接口**
model Admin {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  /// scrypt 哈希，格式 scrypt$salt$hash —— 绝不存明文
  passwordHash String    @map("password_hash")
  nickname     String
  /// super | normal。目前只是装饰，不参与任何判断
  role         String    @default("normal")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("admins")
}

/// 客户 = 在 Mimitale 客户端里注册使用软件的人
model Customer {
  id                 Int       @id @default(autoincrement())
  /// 登录标识，统一小写存储
  email              String    @unique
  /// 显示名。
  /// ⚠️ 客户端把它叫 `username`（注册第二步填「用户名」），后台列表叫「昵称」——
  ///    **同一列**，别为名字差异再加一列。注册第一步先填邮箱前缀，第二步覆盖成用户自己填的。
  nickname           String
  /// 头像，`data:image/...;base64`。客户端上传前已经压到 256×256，单张几十 KB
  avatar             String?
  /// scrypt 哈希，格式 `scrypt$salt$hash`。null = 还没走完注册第二步
  passwordHash       String?   @map("password_hash")
  /// 24 位凭证码 `XXXX-XXXX-…`。换机器 / 重装后靠它登回来，是这个项目唯一的「迁移手段」
  /// （云同步不做了，数据全在本机）。null = 老数据或还没生成
  voucher            String?   @unique
  /// 有没有走完注册第二步（头像 + 用户名 + 密码）
  profileReady       Boolean   @default(false) @map("profile_ready")
  /// active | banned —— 代码枚举，不进字典
  status             String    @default("active")
  /// 字典 ban_reason 的 value；解封时清空
  banReason          String?   @map("ban_reason")
  /// 字典 membership_level 的 value；none = 非会员（哨兵，不进字典）。
  /// ⚠️ **免费天数不是会员**：注册送的那 30 天不写等级，只写 free_expire_at
  membershipLevel    String    @default("none") @map("membership_level")
  /// 会员到期时间（后台发的）。「是否过期」由它和当前时间推导，**不存 expired 布尔**
  membershipExpireAt DateTime? @map("membership_expire_at")
  /// 免费天数用到哪天：注册送 30 天、每邀 1 人再 +7 天累加。
  /// ⚠️ 和 membership_expire_at **互不吞噬**，权益取两者最大的那个。
  ///    这样「免费还剩几天」就是一个减法，不用从混合区间里拆
  freeExpireAt       DateTime? @map("free_expire_at")
  /// 注册时填的码 —— **别人给我的**。来源可能是后台发的卡密，也可能是另一个客户的邀请码。
  /// 卡密是一码一次，邀请码能邀多人，两者长一个形状（`MIMI-XXXX-XXXX`）。
  inviteCode         String?   @map("invite_code")
  /// **我自己的**邀请码，别人注册时填它我就多一个被邀请者。一人一个、可邀多人。
  /// null = 还没生成（老数据），第一次取「个人信息」时补上
  referralCode       String?   @unique @map("referral_code")
  /// 邀请我的人是谁（客户 id）。来源是后台卡密时为 null。
  /// ⚠️ 只存 id 不建关系 —— 本库「不建任何外键」是定死的，删号不留残骸靠逻辑处理
  referredById       Int?      @map("referred_by_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  lastLoginAt        DateTime? @map("last_login_at")

  // 「今天注册了多少」每次打开后台都要查
  @@index([createdAt])
  @@index([status])
  // 「我邀请了谁」在个人信息页要数
  @@index([referredById])
  @@map("customers")
}

/// 客户登录记录 —— 后台「登录记录」和 IP 统计都靠它。
///
/// ⚠️ 单独一张表，**不要**混进 operation_logs：那张表的语义是「管理员做过什么」，
///    admin_id / admin_name 是必填的，客户登录写进去会变成「系统自己操作了自己」。
/// ⚠️ 只记成功登录。失败的密码尝试量大十倍，而且这块要看的是「人从哪来」，
///    不是撞库审计（真要审计得另配限流计数）。
model LoginLog {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  /// password | voucher | register —— 代码枚举，不进字典。
  /// ⚠️ 「打开软件」不在这一列了：搬到 client_sessions，那里一次启动一行更准
  method     String   @default("password")
  /// 客户端出口 IP。⚠️ 上了 nginx 记得开 Fastify trustProxy，否则全是 127.0.0.1
  ip         String   @default("")
  /// Electron 的 UA 里带客户端版本号，排查「旧版本还在用」时有用
  userAgent  String   @default("") @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("login_logs")
}

/// 客户端使用会话 —— 一次「打开软件到关闭」记一行，时长、版本、崩溃都在这里。
///
/// ⚠️ 和 login_logs 的分工：login_logs 是**事件流**（登录 / 注册，回答「人从哪来」），
///    这张表是**计量**（开了多久、什么版本、怎么结束的，回答「用得多勤」）。
///    所以「打开软件」从 login_logs 撤掉，搬到这里 —— 每次启动一行，比按天去重更准。
/// ⚠️ 结束时间靠「下次启动结清」而不是 before-quit 同步上报：强杀 / 断电 / 崩溃
///    都没法在退出那一刻写库，只能下次启动用最后心跳时间当结束时间补上。
///    所以 ended_at 可能和真实退出差一个心跳间隔（5 分钟），算「每天用了多久」够用。
model ClientSession {
  id         Int       @id @default(autoincrement())
  customerId Int       @map("customer_id")
  /// 这次启动的进程（同一天开两次 = 两行）
  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamp(3)
  /// 心跳刷新；没心跳过就是 null
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamp(3)
  /// 结束时间；null = 还没结清（下一次启动 / exit 会补上）
  endedAt    DateTime? @map("ended_at") @db.Timestamp(3)
  /// quit（正常退）/ crash（崩溃）/ unknown（没结清、心跳也停了）
  endReason  String?   @map("end_reason")
  /// end_reason = crash 时的补充：render-process-gone 的 reason / 退出码
  endDetail  String    @default("") @map("end_detail")
  /// 客户端版本号，排查「谁还在用老版本」的唯一线索
  appVersion String    @default("") @map("app_version")
  /// 会话结束时的出口 IP（客户端可能换网，所以只存结束时的）
  ip         String    @default("") @map("ip")
  userAgent  String    @default("") @map("user_agent")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamp(3)

  @@index([customerId, startedAt])
  @@index([endedAt])
  @@map("client_sessions")
}

/// 天数流水 —— 每给客户加一次天数就写一条。
///
/// ⚠️ 别想着在 customers 上存一个「这份会员是什么来源」的字段：一个人可能
///    注册送 30 天 + 邀请 3 人 +21 天 + 后台续 30 天，一个值怎么说都是错的。
///    要回答的从来不是「他是哪种会员」，而是「这些天是谁给的」。
/// ⚠️ startsAt / expiresAt 记的是**这一段天数的区间**，后一次从前一次的到期日接着算，
///    所以按区间求和就能精确拆出「免费几天、会员几天」，不用再猜。
model MembershipGrant {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  days       Int
  /// trial（注册）/ invite（邀请）/ admin（后台发）—— 代码枚举，不进字典
  source     String
  /// 一句话说明，例：「每邀 1 人 +7 天」「邀请人：小明」
  note       String   @default("")
  /// 这 7 天是因为谁得的：invite 存被邀请人 id，admin 存管理员 id
  refId      Int?     @map("ref_id")
  /// 这段天数从哪天开始（= 加之前的到期日和今天取大的）
  startsAt   DateTime @map("starts_at")
  /// 到哪天结束。⚠️ 同一客户相邻两条必须首尾相接，中间的空档会算错「还剩几天」
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([customerId, createdAt])
  @@map("membership_grants")
}

/// 操作日志 —— 只由后端写，没有写入接口
model OperationLog {
  id         Int      @id @default(autoincrement())
  adminId    Int      @map("admin_id")
  /// 冗余存一份：管理员改了昵称，历史日志不该跟着变
  adminName  String   @map("admin_name")
  /// customer.ban / customer.unban / customer.membership
  /// card.create / card.void / dict.create / dict.update / dict.delete
  action     String
  /// customer | card | dict
  targetType String   @map("target_type")
  targetId   Int?     @map("target_id")
  /// 同样冗余：客户改了昵称，老日志还是当时的名字
  targetName String   @map("target_name")
  /// 一句话说清改了什么，例：「发会员：初级会员 +30 天（新开通）」
  detail     String
  ip         String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetType, targetId])
  @@map("operation_logs")
}

/// 卡密 —— 会员续费换钱之前唯一的「发号」手段
model InviteCard {
  id               Int       @id @default(autoincrement())
  /// MIMI-7K2M-9QXA
  code             String    @unique
  /// 字典 card_note 的显示名，例：种子用户
  note             String    @default("")
  /// unused | used | void —— 代码枚举，不进字典
  status           String    @default("unused")
  usedByCustomerId Int?      @map("used_by_customer_id")
  usedAt           DateTime? @map("used_at")
  /// null = 永久有效
  expireAt         DateTime? @map("expire_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([usedByCustomerId])
  @@map("invite_cards")
}

/// 字典类型 —— 只放「加一个值不需要改代码」的枚举
model DictType {
  code      String   @id
  name      String
  remark    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("dict_types")
}

model DictItem {
  id       Int     @id @default(autoincrement())
  typeCode String  @map("type_code")
  /// 给人看的，例：刷屏广告
  label    String
  /// 存进数据库的，例：spam
  value    String
  /// 小的排前面
  sort     Int     @default(100)
  /// 停用后新地方选不到，历史数据照旧显示
  enabled  Boolean @default(true)
  remark   String  @default("")

  @@unique([typeCode, value])
  @@index([typeCode])
  @@map("dict_items")
}

/// 邮箱验证码。放数据库而不是内存 —— 后端重启不该把正在登录的人踢出去
model LoginCode {
  id         Int       @id @default(autoincrement())
  email      String
  code       String
  expiresAt  DateTime  @map("expires_at")
  /// 用过一次就作废，防止同一条验证码被重复提交
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@map("login_codes")
}

/**
 * ==================================================================
 */
/**
 * 消息：用户发给运营（反馈） / 运营发给用户（公告）
 */
/**
 * ==================================================================
 */

/// 意见反馈 —— 客户端「意见反馈」弹窗提交上来的那段话。
///
/// ⚠️ **不登录也能发**（星宝 2026-10-28 定的）：新用户「连登录都进不去」的时候
///    恰恰最需要报错，要是先要求登录就废了。所以 customer_id 可以为 null，
///    同时冗余存一份 contact_email / contact_name —— 客户后来注销了，
///    这条反馈里的联系人也还在，不会变成一条查不到是谁的孤魂。
/// ⚠️ 不建外键（本库定死的规矩），customer_id 只是个逻辑字段。
model Feedback {
  id           Int       @id @default(autoincrement())
  /// 登录状态下提交时才有；未登录为 null
  customerId   Int?      @map("customer_id")
  /// 提交时客户填/带上的联系方式。未登录又没填就是空串
  contactEmail String    @default("") @map("contact_email")
  /// 冗余昵称：客户改了名字，历史反馈还是当时的署名
  contactName  String    @default("") @map("contact_name")
  /// bug | idea | other —— 代码枚举，不进字典。
  /// 和客户端弹窗里那三颗按钮一一对应（问题 / 建议 / 其它）
  kind         String    @default("bug")
  /// 正文。长度上限在接口层卡（2000 字），这里不设 varchar 长度
  content      String
  /// 客户端版本号，例：1.4.2 —— 「只有老版本会崩」是常见结论，没这个就查不动
  appVersion   String    @default("") @map("app_version")
  /// win32 / darwin / linux，取自 process.platform
  platform     String    @default("")
  /// 设备指纹（客户端持久化的一个随机串）。两个用途：
  /// ① 未登录时按它限频，不然一个人能刷一万条
  /// ② 判断「这是同一个人在反复报同一个问题」
  deviceId     String    @default("") @map("device_id")
  /// pending | read | resolved | ignored —— 代码枚举，不进字典。
  /// pending = 还没人看（列表默认按它筛），read = 看过了，resolved = 已处理，ignored = 不打算处理
  status       String    @default("pending")
  /// 管理员写的**内部备注**，只给自己看，不回传给客户端。
  /// ⚠️ 别把它当「回复」用 —— 客户端没有收回复的地方，写了也送不到人手上
  note         String    @default("")
  /// 最近一次改状态的人（管理员昵称，冗余）
  handledBy    String    @default("") @map("handled_by")
  handledAt    DateTime? @map("handled_at")
  /// 提交时的出口 IP。上了 nginx 要开 trustProxy，否则全是 127.0.0.1
  ip           String    @default("")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  /// 后台默认视图 = 「待处理的按时间倒序」，这条索引正好盖住它
  @@index([status, createdAt])
  @@index([customerId])
  @@index([createdAt])
  @@map("feedbacks")
}

/// 通知公告 —— 管理端写一条，客户端启动时拉下来显示。
///
/// ⚠️ 和 feedbacks 方向相反，别合并成一张「消息表」：一个是外部进来的，
///    一个是内部发出去的，权限、状态机、生命周期全都不一样。
/// ⚠️ 「现在要不要显示」由 enabled + startsAt + endsAt **三个一起推导**，
///    不存 visible 布尔 —— 存了就得有人定时去翻它，翻漏了就永远不消失。
model Announcement {
  id         Int       @id @default(autoincrement())
  title      String
  /// 正文。客户端横条只显示首行，点开看全文
  content    String
  /// normal | important | maintenance —— 代码枚举，决定客户端横条的颜色和图标
  level      String    @default("normal")
  /// 下架开关。false = 客户端拉不到（历史已读记录保留，重新上架后照旧算已读）
  enabled    Boolean   @default(true)
  /// 置顶。客户端横条按 pinned 优先，最多同时显示 2 条
  pinned     Boolean   @default(false)
  /// 生效时间；null = 立刻生效
  startsAt   DateTime? @map("starts_at")
  /// 失效时间；null = 永不失效
  endsAt     DateTime? @map("ends_at")
  /// 谁发的（管理员 id / 昵称冗余，管理员改名不影响历史）
  authorId   Int       @default(0) @map("author_id")
  authorName String    @default("") @map("author_name")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  @@index([enabled, createdAt])
  @@map("announcements")
}

/// 公告已读 —— 谁看过哪一条。
///
/// ⚠️ 只给**登录用户**记。未登录的人客户端只在本地 localStorage 记一份，
///    不然得给每个匿名设备造一个假客户 id，那是自找麻烦。
/// ⚠️ 没有 customer_id 的外键，也没有 announcement_id 的外键（本库不建外键）：
///    公告被删了，这张表里的行就是垃圾数据，靠「读的时候 join 一下过滤掉」处理。
model AnnouncementRead {
  id             Int      @id @default(autoincrement())
  announcementId Int      @map("announcement_id")
  customerId     Int      @map("customer_id")
  readAt         DateTime @default(now()) @map("read_at")

  /// 一个人一条公告只有一行，重复标记已读走 upsert
  @@unique([announcementId, customerId])
  @@index([customerId])
  @@map("announcement_reads")
}
