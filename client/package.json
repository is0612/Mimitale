{
  "name": "mimitale",
  "productName": "Mimitale",
  "version": "1.0.0",
  "description": "Mimitale - 一个简单的桌面对话 AI（Electron + OpenAI 兼容 API）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "node tools/dev.js",
    "start:no-sandbox": "electron --no-sandbox .",
    "smoke": "electron --no-sandbox tools/smoke-test.js",
    "diag": "electron --no-sandbox tools/diag-page.js",
    "audit": "node tools/check-dom-ids.js && node tools/audit-buttons.js && node tools/check-imports.js",
    "test:pet": "node tools/test-pet-window.js && node tools/test-pet-store.js",
    "test:png": "node tools/test-png.js",
    "check:integrity": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/clear-low-integrity.ps1",
    "fix:integrity": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/clear-low-integrity.ps1 -Fix"
  },
  "devDependencies": {
    "electron": "^44.4.3"
  }
}
