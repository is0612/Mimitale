{
  "name": "mimitale",
  "productName": "Mimitale",
  "version": "1.0.0",
  "description": "Mimitale - 一个简单的桌面对话 AI（Electron + OpenAI 兼容 API）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dev": "node tools/dev.js",
    "start:no-sandbox": "electron --no-sandbox .",
    "smoke": "electron --no-sandbox tools/smoke-test.js",
    "diag": "electron --no-sandbox tools/diag-page.js",
    "audit": "node tools/check-dom-ids.js && node tools/audit-buttons.js && node tools/check-imports.js && node tools/check-icons.js",
    "audit:css": "node tools/audit-radius.js && node tools/audit-font.js && node tools/audit-spacing.js && node tools/audit-css-dead.js",
    "test:theme": "node --test tools/test-theme-tokens.js",
    "test:pet": "node tools/test-pet-window.js && node tools/test-pet-store.js",
    "test:png": "node tools/test-png.js",
    "test:ui": "node --test tools/test-ui-controls.js tools/test-ui-components.js",
    "test:records": "node --test tools/test-record-store.js",
    "test:records:ipc": "electron --no-sandbox tools/test-record-ipc.js",
    "test:library-changes": "node --test tools/test-library-changes.js",
    "test:library-close": "electron --no-sandbox tools/test-library-close.js",
    "test:conversation-close": "electron --no-sandbox tools/test-conversation-close.js",
    "test:library-recovery": "node --test tools/test-library-transaction.js tools/test-library-recovery.js",
    "test:roleplay": "node --test tools/test-chat-state.js tools/test-panel-authority.js tools/test-roleplay-rag.js tools/test-roleplay-preparation.js tools/test-worldbook-match.js",
    "shot:components": "electron --no-sandbox tools/shot-components.js",
    "check:integrity": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/clear-low-integrity.ps1",
    "fix:integrity": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/clear-low-integrity.ps1 -Fix"
  },
  "devDependencies": {
    "electron": "^44.4.3"
  }
}
